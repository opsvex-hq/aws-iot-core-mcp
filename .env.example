# ---------------------------------------------------------------------------
# aws-iot-core-mcp - example configuration
#
# Only AWS_REGION is required. Every other value has a safe default, and an
# invalid value aborts startup rather than silently falling back.
# ---------------------------------------------------------------------------

# Region holding the fleet. IoT Core is regional: the wrong region looks
# exactly like an empty account.
AWS_REGION=us-east-1

# Credentials come from the standard AWS chain. This server never accepts a
# credential as a tool argument or a request field.
# AWS_PROFILE=iot-readonly

# --- Narrowing what the server can reach ----------------------------------
# Tool allowlist. Unlisted tools are not registered at all. A name that does
# not exist aborts startup, so a typo cannot leave you with no tools.
# AWS_IOT_MCP_TOOLS=assess_fleet_health,get_device_shadow,search_fleet_index

# Thing-name globs. Anything unmatched is refused before any AWS call, and
# never appears in list or search output.
# AWS_IOT_MCP_THING_ALLOW=gw-*,sensor-01

# --- Budgets ---------------------------------------------------------------
# AWS_IOT_MCP_MAX_ITEMS=100
# AWS_IOT_MCP_MAX_FLEET_SAMPLE=25
# AWS_IOT_MCP_MAX_UNTRUSTED_BYTES=24000

# --- Audit (one JSON line per call, on stderr) -----------------------------
# AWS_IOT_MCP_AUDIT=on
# AWS_IOT_MCP_AUDIT_ARGS=on

# --- Health thresholds -----------------------------------------------------
# Critical must be at least as strict as warning, or startup fails.
# AWS_IOT_MCP_STALE_WARN_SECONDS=3600
# AWS_IOT_MCP_STALE_CRITICAL_SECONDS=86400
# AWS_IOT_MCP_CERT_WARN_DAYS=45
# AWS_IOT_MCP_CERT_CRITICAL_DAYS=14

# --- HTTP transport (stateless; has NO authentication of its own) ----------
# AWS_IOT_MCP_HTTP_PORT=3000
# AWS_IOT_MCP_HTTP_HOST=127.0.0.1
# AWS_IOT_MCP_HTTP_PATH=/mcp
